{
  "buildCommand": "node scripts/hash-js.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/js/:hash/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/maps", "destination": "/api/render?page=maps" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/:map(dust2|mirage|inferno|nuke|ancient|anubis|overpass|cache)",
      "destination": "/api/render?page=map&map=:map"
    },
    {
      "source": "/:map(dust2|mirage|inferno|nuke|ancient|anubis|overpass|cache)/:type(smoke|flash|fire|he|decoy)/:slug",
      "destination": "/api/render?page=lineup&map=:map&type=:type&slug=:slug"
    }
  ]
}
